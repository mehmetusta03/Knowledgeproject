<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/mehme/ontologies/2026/superlig#"
     xml:base="http://www.semanticweb.org/mehme/ontologies/2026/superlig"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:superlig="http://www.semanticweb.org/mehme/ontologies/2026/superlig#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig/2.0"/>
        <rdfs:comment xml:lang="en">An OWL 2 ontology representing the Turkish Süper Lig professional football league. Includes all 19 current teams, players, managers, stadiums, cities, playing positions, matches and seasons. Developed in Protégé 5.x using the METHONTOLOGY methodology. Phase 2 — May 2026.</rdfs:comment>
        <rdfs:label xml:lang="en">Süper Lig Football Knowledge Ontology</rdfs:label>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#awayTeam -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#awayTeam">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Match"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <rdfs:comment xml:lang="en">Relates a Match to the Team playing as the away side. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">awayTeam</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasHomeStadium -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasHomeStadium">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Stadium"/>
        <rdfs:comment xml:lang="en">Relates a Team to the Stadium it uses for home matches.</rdfs:comment>
        <rdfs:label xml:lang="en">hasHomeStadium</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasPlayer -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasPlayer">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Player"/>
        <rdfs:comment xml:lang="en">Relates a Team to a Player currently contracted to it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasPlayer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#homeTeam -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#homeTeam">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Match"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <rdfs:comment xml:lang="en">Relates a Match to the Team playing as the home side. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">homeTeam</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#isManagedBy -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#isManagedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Manager"/>
        <rdfs:comment xml:lang="en">Relates a Team to its current head coach or manager.</rdfs:comment>
        <rdfs:label xml:lang="en">isManagedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#locatedInCity -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#locatedInCity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Stadium"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#City"/>
        <rdfs:comment xml:lang="en">Relates a Team or Stadium to the City in which it is geographically situated.</rdfs:comment>
        <rdfs:label xml:lang="en">locatedInCity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#partOfSeason -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#partOfSeason">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Match"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Season"/>
        <rdfs:comment xml:lang="en">Relates a Match to the Season it belongs to. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">partOfSeason</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#participatesIn -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#participatesIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Match"/>
        <rdfs:comment xml:lang="en">Relates a Team to a Match in which it takes part. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">participatesIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#playedAt -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#playedAt">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Match"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Stadium"/>
        <rdfs:comment xml:lang="en">Relates a Match to the Stadium where it was played. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">playedAt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#playsPosition -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#playsPosition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Player"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Position"/>
        <rdfs:comment xml:lang="en">Relates a Player to their primary playing Position on the pitch. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">playsPosition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasAge -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasAge">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Player"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The age in years of a Player. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">hasAge</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasCapacity -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasCapacity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Stadium"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The official seating capacity of a Stadium. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">hasCapacity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasFoundedYear -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasFoundedYear">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The year in which a Team was officially founded. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">hasFoundedYear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasJerseyNumber -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasJerseyNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Player"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The shirt number of a Player. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">hasJerseyNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasNationality -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#hasNationality">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Manager"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Player"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The nationality of a Player or Manager. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">hasNationality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#City -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#City">
        <rdfs:comment xml:lang="en">A Turkish city in which one or more Süper Lig teams or stadiums are located.</rdfs:comment>
        <rdfs:label xml:lang="en">City</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Manager -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Manager">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Person"/>
        <rdfs:comment xml:lang="en">The head coach or technical director responsible for managing a Süper Lig team.</rdfs:comment>
        <rdfs:label xml:lang="en">Manager</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Match -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Match">
        <rdfs:comment xml:lang="en">An individual competitive fixture between two Süper Lig teams. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">Match</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Person -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Person">
        <rdfs:comment xml:lang="en">Abstract superclass for any human individual in the football domain.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Player -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Player">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Person"/>
        <rdfs:comment xml:lang="en">A professional footballer currently contracted to a Süper Lig club.</rdfs:comment>
        <rdfs:label xml:lang="en">Player</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Position -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Position">
        <rdfs:comment xml:lang="en">A playing position on a football pitch: Forward, Midfielder, Defender, or Goalkeeper. [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">Position</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Referee -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Referee">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Person"/>
        <rdfs:comment xml:lang="en">A licensed match official. Included for structural completeness; currently out of scope for population.</rdfs:comment>
        <rdfs:label xml:lang="en">Referee</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Season -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Season">
        <rdfs:comment xml:lang="en">A Süper Lig football season (e.g., 2025-26). [Added v2]</rdfs:comment>
        <rdfs:label xml:lang="en">Season</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Stadium -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Stadium">
        <rdfs:comment xml:lang="en">A physical sports venue where Süper Lig matches are played.</rdfs:comment>
        <rdfs:label xml:lang="en">Stadium</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team -->


    <owl:Class rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team">
        <rdfs:comment xml:lang="en">A professional football club participating in the Turkish Süper Lig in the 2025-26 season.</rdfs:comment>
        <rdfs:label xml:lang="en">Team</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Abdullah_Avci -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Abdullah_Avci">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Manager"/>
        <hasNationality>Turkish</hasNationality>
        <rdfs:label xml:lang="en">Abdullah Avci</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Adis_Jahovic -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Adis_Jahovic">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Player"/>
        <playsPosition rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Forward"/>
        <hasJerseyNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</hasJerseyNumber>
        <hasNationality>Macedonian</hasNationality>
        <rdfs:label xml:lang="en">Adis Jahovic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Alanyaspor -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Alanyaspor">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <locatedInCity rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalya"/>
        <hasFoundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1948</hasFoundedYear>
        <rdfs:label xml:lang="en">Alanyaspor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ankara -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ankara">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#City"/>
        <rdfs:label xml:lang="en">Ankara</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ankara_Stad -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ankara_Stad">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Stadium"/>
        <locatedInCity rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ankara"/>
        <hasCapacity rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19800</hasCapacity>
        <rdfs:label xml:lang="en">Ankara Stadium</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ankaragucu -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ankaragucu">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <hasHomeStadium rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ankara_Stad"/>
        <locatedInCity rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ankara"/>
        <hasFoundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1910</hasFoundedYear>
        <rdfs:label xml:lang="en">Ankaragucu</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalya -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalya">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#City"/>
        <rdfs:label xml:lang="en">Antalya</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalya_Stadium -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalya_Stadium">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Stadium"/>
        <locatedInCity rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalya"/>
        <hasCapacity rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32536</hasCapacity>
        <rdfs:label xml:lang="en">Antalya Stadium</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalyaspor -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalyaspor">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <hasHomeStadium rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalya_Stadium"/>
        <locatedInCity rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Antalya"/>
        <hasFoundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1966</hasFoundedYear>
        <rdfs:label xml:lang="en">Antalyaspor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ataturk_Olympic_Stadium -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ataturk_Olympic_Stadium">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Stadium"/>
