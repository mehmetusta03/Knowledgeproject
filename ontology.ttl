        <hasCapacity rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">76092</hasCapacity>
        <rdfs:label xml:lang="en">Ataturk Olympic Stadium</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Basaksehir_FK -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Basaksehir_FK">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <hasHomeStadium rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ataturk_Olympic_Stadium"/>
        <isManagedBy rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Ismail_Kartal"/>
        <locatedInCity rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Istanbul"/>
        <hasFoundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1990</hasFoundedYear>
        <rdfs:label xml:lang="en">Basaksehir FK</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/mehme/ontologies/2026/superlig#Besiktas -->


    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Besiktas">
        <rdf:type rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Team"/>
        <hasHomeStadium rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Tupras_Stadium"/>
        <hasPlayer rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Rafa_Silva"/>
        <isManagedBy rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Serdar_Topraktepe"/>
        <locatedInCity rdf:resource="http://www.semanticweb.org/mehme/ontologies/2026/superlig#Istanbul"/>
        <hasFoundedYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1903</hasFoundedYear>
        <rdfs:label xml:lang="en">Besiktas</rdfs:label>
